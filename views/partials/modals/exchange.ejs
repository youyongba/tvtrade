<div class="modal-overlay" id="exchangeModal">
    <div class="modal">
        <div class="modal-header">
            <h3 class="modal-title">🔗 交易所 API 配置</h3>
            <button class="modal-close" onclick="closeModal('exchangeModal')">×</button>
        </div>
        <div class="modal-body">
            <!-- 连接状态显示 -->
            <div id="exchangeConnectionStatus" style="display: none; margin-bottom: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem; background: var(--bg-tertiary); border-radius: 8px;">
                    <span class="status-dot" id="exchangeStatusDot" style="background: var(--success);"></span>
                    <span id="exchangeStatusText" style="flex: 1;">已连接</span>
                    <span id="exchangeBalanceText" style="font-family: 'JetBrains Mono', monospace; color: var(--accent-gold);"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">选择交易所</label>
                <select class="form-input" id="exchangeSelect" onchange="onExchangeChange()">
                    <option value="binance">Binance Futures</option>
                    <option value="okx">OKX</option>
                    <option value="bybit">Bybit</option>
                    <option value="bitget">Bitget</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">API Key</label>
                <input type="text" class="form-input mono-input" id="apiKey" placeholder="请输入 API Key">
            </div>
            <div class="form-group">
                <label class="form-label">API Secret</label>
                <div class="password-input-wrapper">
                    <input type="password" class="form-input mono-input" id="apiSecret" placeholder="请输入 API Secret">
                    <button class="toggle-password" onclick="togglePasswordVisibility('apiSecret')">👁️</button>
                </div>
            </div>
            <div class="form-group" id="passphraseGroup">
                <label class="form-label">Passphrase <span id="passphraseRequired" style="color: var(--danger); display: none;">*必填</span></label>
                <div class="password-input-wrapper">
                    <input type="password" class="form-input mono-input" id="apiPassphrase" placeholder="OKX、Bitget 等交易所需要">
                    <button class="toggle-password" onclick="togglePasswordVisibility('apiPassphrase')">👁️</button>
                </div>
            </div>
            <div class="api-warning">
                <span class="warning-icon">⚠️</span>
                <div>
                    <strong>安全提示</strong>
                    <p>请确保您的API Key仅开启交易权限，不要开启提币权限。建议设置IP白名单。</p>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-secondary" onclick="testApiConnection()">测试连接</button>
                <button class="btn-primary" onclick="saveExchangeConfig()">保存配置</button>
            </div>
            <!-- 删除配置按钮 -->
            <div id="deleteExchangeBtn" style="display: none; margin-top: 1rem; text-align: center;">
                <button onclick="deleteExchangeConfig()" style="background: none; border: none; color: var(--danger); cursor: pointer; font-size: 0.875rem;">
                    删除当前配置
                </button>
            </div>
        </div>
    </div>
</div>
